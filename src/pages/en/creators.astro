---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FORMSPREE_CREATORS, CONTACT_EMAIL } from '../../config';

// Programme créatrices — miroir de la table `creators` (commission_pct 30)
// et de tools/creators_lib.js côté app : 30 % du montant payé (après −10 %),
// remboursements exclus ; vente attribuée par code promo, sinon par le lien.

const perks = [
  {
    big: '30 %',
    title: 'Commission on every sale',
    line: 'You earn 30 % of what your audience pays for a Tailored itinerary (after their discount). Refunded orders are excluded.',
  },
  {
    big: '−10 %',
    title: 'Your own promo code',
    line: 'A code in your name (e.g. YOURNAME) gives your followers 10 % off Tailored. Every order with your code is yours.',
  },
  {
    big: '1 link',
    title: 'Your tracked link',
    line: 'One link for your bio, stories and captions. It opens the App Store or Google Play and remembers you sent them — first click wins.',
  },
];

const steps = [
  { t: 'Apply below', d: 'Tell us who you are and where you post. We reply within 48 h.' },
  { t: 'Get your code and link', d: 'We create your promo code and your personal link, e.g. app.getpacklight.com/?utm_source=creator&utm_campaign=yourname.' },
  { t: 'Share PackLight your way', d: 'Show a trip you generated, a multi-country route, your packing list — whatever fits your content.' },
  { t: 'Monthly report', d: 'Each month you receive your numbers: installs, trips generated, Tailored sales and the commission owed.' },
];

const faq = [
  {
    q: 'What exactly earns commission?',
    a: 'Tailored orders (the €69 itinerary reviewed by hand) placed with your code, or through your link if no code was used. You get 30 % of the amount actually paid.',
  },
  {
    q: 'Do I need a big audience?',
    a: 'No. We care about travel content people trust — working holiday, backpacking, road trips, first big trips. Micro-creators are very welcome.',
  },
  {
    q: 'Is the app free for my followers?',
    a: 'Yes, PackLight is free on iOS and Android. The code applies to Tailored.',
  },
];
---
<BaseLayout
  title="Creators"
  description="PackLight creator programme: 30 % commission, your own promo code (−10 % for your audience) and a tracked link. Apply in 2 minutes."
>
  <!-- INTRO -->
  <section class="section intro">
    <div class="container">
      <span class="badge">Creator programme</span>
      <h1>Share PackLight, earn 30 %.</h1>
      <p class="lede">
        You inspire people to travel. PackLight turns that urge into a day-by-day
        itinerary in 30 seconds. Partner with us: your audience gets a discount,
        you get paid on every sale you bring.
      </p>
      <a class="btn btn-amber btn-lg" href="#apply">Apply now</a>
    </div>
  </section>

  <!-- PERKS -->
  <section class="section section-sand">
    <div class="container">
      <h2>What you get</h2>
      <div class="perks">
        {perks.map((p) => (
          <div class="perk reveal">
            <span class="perk-big">{p.big}</span>
            <h3>{p.title}</h3>
            <p>{p.line}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="container">
      <h2>How it works</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="step-num">{i + 1}</span>
            <div><strong>{s.t}</strong><p>{s.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-sand">
    <div class="container">
      <h2>Questions</h2>
      <div class="faq">
        {faq.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FORM -->
  <section class="section" id="apply">
    <div class="container">
      <div class="apply">
        <h2>Apply to the programme</h2>
        <p class="apply-sub">Two minutes. We reply within 48 h.</p>

        <form class="creator-form" action={FORMSPREE_CREATORS} method="POST">
          <input type="hidden" name="_subject" value="New creator application — PackLight" />
          <input type="hidden" name="source" value="site — /en/creators" />
          <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <label for="cr-name">Name</label>
          <input id="cr-name" type="text" name="name" required autocomplete="name" />

          <label for="cr-email">Email</label>
          <input id="cr-email" type="email" name="email" required autocomplete="email" placeholder="you@email.com" />

          <label for="cr-handle">Main account (Instagram, TikTok, YouTube…)</label>
          <input id="cr-handle" type="text" name="handle" required placeholder="@yourhandle" />

          <label for="cr-audience">Audience size</label>
          <select id="cr-audience" name="audience">
            <option value="">Choose…</option>
            <option>Under 5k</option>
            <option>5k–20k</option>
            <option>20k–100k</option>
            <option>100k+</option>
          </select>

          <label for="cr-message">Tell us about your content (optional)</label>
          <textarea id="cr-message" name="message" rows="4" placeholder="Where you travel, who follows you, the code you'd like…"></textarea>

          <button type="submit" class="btn btn-amber btn-lg">Send my application</button>
        </form>

        <p class="form-success" hidden>Thanks! Your application is in — we'll get back to you within 48 h.</p>
        <p class="form-error" hidden>
          Something went wrong. Try again in a moment, or email
          <a href={`mailto:${CONTACT_EMAIL}?subject=PackLight%20creator%20programme`}>{CONTACT_EMAIL}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .badge {
    display: inline-block;
    background: var(--amber-soft);
    color: var(--amber-dark);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }
  .intro .lede {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 1.25rem 0 2rem;
  }
  .btn-lg { font-size: 1.05rem; padding: 1rem 1.75rem; }

  .perks { display: grid; gap: 1.25rem; margin-top: 1.75rem; }
  .perk {
    background: var(--surface);
    border: 1px solid var(--sand-line);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
  }
  .perk-big {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2rem;
    color: var(--teal);
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }
  .perk h3 { margin-bottom: 0.4rem; }
  .perk p { margin: 0; color: var(--ink-soft); line-height: 1.55; }

  .steps { list-style: none; padding: 0; margin: 1.75rem 0 0; display: grid; gap: 1.25rem; }
  .steps li { display: flex; gap: 1rem; align-items: flex-start; }
  .step-num {
    flex: none;
    width: 36px; height: 36px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--amber); color: #fff; font-weight: 700;
  }
  .steps p { margin: 0.25rem 0 0; color: var(--ink-soft); overflow-wrap: anywhere; }

  .faq { display: grid; gap: 1.25rem; margin-top: 1.5rem; }
  .faq-item h3 { margin-bottom: 0.35rem; }
  .faq-item p { margin: 0; color: var(--ink-soft); }

  .apply {
    max-width: 560px;
    margin: 0 auto;
    background: var(--surface);
    border: 1px solid var(--sand-line);
    border-radius: var(--radius);
    padding: 2rem 1.25rem;
    box-shadow: var(--shadow-lg);
  }
  .apply-sub { color: var(--ink-muted); margin: 0.4rem 0 1.5rem; }
  .creator-form { display: flex; flex-direction: column; gap: 0.4rem; }
  .creator-form label { font-weight: 600; font-size: 0.92rem; margin-top: 0.6rem; }
  .creator-form input,
  .creator-form select,
  .creator-form textarea {
    font: inherit;
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--sand-line);
    border-radius: var(--radius-sm);
    background: var(--off-white);
    color: var(--ink);
  }
  .creator-form input:focus,
  .creator-form select:focus,
  .creator-form textarea:focus { outline: 2px solid var(--teal); outline-offset: 1px; }
  .creator-form .btn { margin-top: 1.25rem; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .form-success { color: var(--teal); font-weight: 600; }
  .form-error { color: var(--amber-dark); font-weight: 600; }

  @media (min-width: 720px) {
    .perks { grid-template-columns: repeat(3, 1fr); }
    .faq { grid-template-columns: repeat(2, 1fr); }
    .apply { padding: 2.5rem; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.creator-form');
  const success = document.querySelector<HTMLElement>('.form-success');
  const errorMsg = document.querySelector<HTMLElement>('.form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg?.setAttribute('hidden', '');
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (btn) btn.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.setAttribute('hidden', '');
        success?.removeAttribute('hidden');
      } else {
        errorMsg?.removeAttribute('hidden');
      }
    } catch {
      errorMsg?.removeAttribute('hidden');
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
