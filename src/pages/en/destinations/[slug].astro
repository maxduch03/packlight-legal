---
import { getCollection } from 'astro:content';
import DestinationLayout from '../../../layouts/DestinationLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('destinations', (e) => e.data.lang === 'en' && e.data.published);
  return entries.map((entry) => ({
    params: { slug: entry.data.pageSlug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---
<DestinationLayout entry={entry} />
