---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ComingSoon from '../../../components/ComingSoon.astro';

const entries = (await getCollection('destinations', (e) => e.data.lang === 'en' && e.data.published))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Destinations" noindex={true}>
  {entries.length === 0 ? (
    <ComingSoon frPath="/fr/destinations" />
  ) : (
    <section class="section">
      <div class="container">
        <h1>Destinations</h1>
        <div class="dest-grid">
          {entries.map((e) => (
            <a class="dest-card" href={`/en/destinations/${e.data.pageSlug}`}>
              {e.data.hero && <img src={e.data.hero} alt={e.data.title} />}
              <div class="dest-card-body">
                <h3>{e.data.title}</h3>
                <p>{e.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
