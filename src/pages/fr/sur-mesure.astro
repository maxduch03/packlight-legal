---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoreButtons from '../../components/StoreButtons.astro';
import { STRIPE_PAYMENT_LINK } from '../../config';

const payHref = `${STRIPE_PAYMENT_LINK}?utm_source=site&utm_campaign=sur-mesure`;
---
<BaseLayout
  title="Sur-mesure"
  description="Ton itinéraire PackLight, ajusté sur-mesure par Maxime. 69 €, retour sous 48 h."
  stickyDownload={false}
>
  <!-- PROMESSE -->
  <section class="section affinage-hero">
    <div class="container">
      <span class="badge">Sur-mesure</span>
      <h1>Ton itinéraire PackLight, ajusté sur-mesure par Maxime.</h1>
      <p class="lead">
        L'app te donne une base solide en 30 secondes. Le Sur-mesure, c'est un regard
        humain par-dessus : on part de ton itinéraire généré dans l'app, on l'ajuste, et
        on répond à tes questions — pour que tu partes vraiment serein.
      </p>
      <a href={payHref} class="btn btn-amber btn-lg">Lancer mon Sur-mesure — 69&nbsp;€</a>
      <p class="price-note">69 € TTC — TVA non applicable, art. 293 B du CGI</p>
      <img
        class="sur-mesure-shot"
        src="/assets/destinations/bali-itineraire.webp"
        alt="Exemple d'itinéraire PackLight ajusté, affiché dans l'application"
        width="760"
        height="1600"
        loading="lazy"
      />
    </div>
  </section>

  <!-- CE QUE TU REÇOIS -->
  <section class="section section-sand">
    <div class="container">
      <h2>Ce que tu reçois</h2>
      <ul class="includes">
        <li>Ton itinéraire réécrit jour par jour, rythme et trajets vérifiés</li>
        <li>3 à 5 bons plans testés sur place (adresses, prix, timing)</li>
        <li>Les liens de réservation présélectionnés : tu valides en 1 clic, tu gardes la main</li>
        <li>Réponse sous 48&nbsp;h, par mail, en PDF + dans l'app</li>
      </ul>
    </div>
  </section>

  <!-- AVANT / APRÈS -->
  <section class="section section-white">
    <div class="container">
      <h2 class="ba-title">Avant / après</h2>
      <p class="ba-sub">Ce que le regard de Maxime change sur ton itinéraire.</p>
      <div class="ba-grid">
        <figure class="ba-col">
          <span class="ba-tag ba-tag-before">Généré par l'app</span>
          <img src="/assets/destinations/bali-itineraire.webp" alt="Itinéraire généré automatiquement dans PackLight" width="760" height="1600" loading="lazy" />
        </figure>
        <figure class="ba-col ba-after">
          <span class="ba-tag ba-tag-after">Relu par Maxime</span>
          <img src="/assets/destinations/sur-mesure-apres.webp" alt="Le même itinéraire, relu et ajusté à la main" width="760" height="1706" loading="lazy" />
          <ul class="ba-notes" aria-label="Ajustements apportés">
            <li>Rythme revu — J3 allégé</li>
            <li>Timing optimisé entre deux étapes</li>
            <li>Bon plan terrain ajouté</li>
          </ul>
        </figure>
      </div>
    </div>
  </section>

  <!-- POUR QUI -->
  <section class="section">
    <div class="container">
      <h2>Pour qui</h2>
      <div class="cards-3">
        <div class="card">
          <h3>Départ en PVT</h3>
          <p>Tu pars en Working Holiday et tu veux sécuriser tes premières semaines sur place.</p>
        </div>
        <div class="card">
          <h3>Premier grand voyage</h3>
          <p>C'est ton premier long voyage et tu veux éviter les erreurs classiques.</p>
        </div>
        <div class="card">
          <h3>Itinéraire multi-villes</h3>
          <p>Ton voyage enchaîne plusieurs étapes et tu veux un enchaînement qui tienne la route.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMMENT ÇA MARCHE -->
  <section class="section">
    <div class="container">
      <h2>Comment ça marche</h2>
      <ol class="steps">
        <li>
          <span class="step-num">1</span>
          <div><strong>Génère ton voyage</strong><p>Crée ton itinéraire dans l'app PackLight.</p></div>
        </li>
        <li>
          <span class="step-num">2</span>
          <div><strong>Paie 69&nbsp;€</strong><p>Règle en ligne et colle ton e-mail ou le lien de partage de ton itinéraire.</p></div>
        </li>
        <li>
          <span class="step-num">3</span>
          <div><strong>Reçois la version affinée</strong><p>Tu reçois ton itinéraire ajusté par mail, sous 48&nbsp;h.</p></div>
        </li>
      </ol>
    </div>
  </section>

  <!-- PRIX / CTA -->
  <section class="section">
    <div class="container prix-cta">
      <div class="price-amount">69&nbsp;€</div>
      <p class="price-note">69 € TTC — TVA non applicable, art. 293 B du CGI</p>
      <p class="price-anchor">Un travel planner facture 150 à 400 € l'itinéraire. Ici 69 €, parce que l'IA fait 80 % du travail et je fais les 20 % qui comptent.</p>
      <div class="reviewer">
        <img class="reviewer-portrait" src="/assets/maxime.webp" alt="Portrait de Maxime Ducher" width="96" height="96" loading="lazy" />
        <p class="reviewer-title">Qui relit ton voyage</p>
        <ul class="reviewer-list">
          <li>Maxime, journaliste, 5 ans de rédactions parisiennes</li>
          <li>6 pays parcourus sur le terrain : Australie, Indonésie, Portugal, Islande, Hawaii, Mayotte</li>
          <li>Réponse sous 48&nbsp;h, itinéraire relu à la main</li>
        </ul>
      </div>
      <a href={payHref} class="btn btn-amber btn-lg">Lancer mon Sur-mesure</a>
      <p class="guarantee">Pas satisfait sous 7 jours → remboursé, sans question.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-sand">
    <div class="container">
      <h2>Questions fréquentes</h2>
      <div class="faq">
        <div class="faq-item">
          <h3>Sous combien de temps je reçois mon itinéraire&nbsp;?</h3>
          <p>Sous 48&nbsp;h après réception de ton paiement et de ton itinéraire.</p>
        </div>
        <div class="faq-item">
          <h3>Et si tu ne peux pas traiter ma demande&nbsp;?</h3>
          <p>Si je ne peux pas traiter ta demande, tu es intégralement remboursé sous 24&nbsp;h.</p>
        </div>
        <div class="faq-item">
          <h3>Les réservations sont-elles comprises&nbsp;?</h3>
          <p>Non : le Sur-mesure porte sur l'itinéraire et les conseils. Aucune réservation n'est à ma charge.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PAS ENCORE L'APP -->
  <section class="section">
    <div class="container app-cta">
      <h2>Pas encore l'app&nbsp;?</h2>
      <p>Commence par générer ton itinéraire gratuitement dans PackLight.</p>
      <StoreButtons medium="sur-mesure" />
    </div>
  </section>

  <!-- MENTION LÉGALE -->
  <p class="legal-micro">PackLight ne réserve pas à ta place : les réservations se font sur les sites partenaires, sous ton nom.</p>

  <!-- CTA STRIPE STICKY (mobile) -->
  <div class="sticky-download" id="sticky-stripe" aria-hidden="true">
    <a href={payHref} class="btn btn-amber" tabindex="-1">Lancer mon Sur-mesure — 69&nbsp;€</a>
  </div>
  <script is:inline>
    (function () {
      var bar = document.getElementById('sticky-stripe');
      if (!bar) return;
      var link = bar.querySelector('a');
      var shown = false;
      function setShown(v) {
        if (v === shown) return;
        shown = v;
        bar.classList.toggle('show', v);
        bar.setAttribute('aria-hidden', v ? 'false' : 'true');
        if (link) link.setAttribute('tabindex', v ? '0' : '-1');
      }
      function onScroll() { setShown(window.scrollY > 600); }
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>
</BaseLayout>

<style>
  .affinage-hero { padding-bottom: 1rem; }
  .sur-mesure-shot {
    display: block;
    width: 240px; max-width: 72%; height: auto;
    border-radius: var(--radius); box-shadow: var(--shadow-lg);
    margin: 1.75rem auto 0.5rem;
  }
  .badge {
    display: inline-block; background: var(--amber); color: #fff;
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.5px;
    text-transform: uppercase; padding: 0.3rem 0.7rem;
    border-radius: 999px; margin-bottom: 1rem;
  }
  .lead { font-size: 1.15rem; max-width: 54ch; margin: 1rem 0 1.75rem; }
  .btn-lg { font-size: 1.05rem; padding: 1rem 1.75rem; }
  .price-note { color: var(--ink-muted); font-size: 0.9rem; margin-top: 0.75rem; }

  .section-sand { background: var(--sand-2); }

  /* Avant / après */
  .ba-title { text-align: center; }
  .ba-sub { text-align: center; color: var(--ink-muted); margin: 0.5rem 0 2rem; }
  .ba-grid { display: grid; gap: 1.75rem; }
  .ba-col {
    position: relative;
    margin: 0;
    text-align: center;
  }
  .ba-col img {
    width: 240px; max-width: 80%; height: auto;
    margin: 0 auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--sand-line);
  }
  .ba-after img { border-color: var(--teal); }
  .ba-tag {
    display: inline-block;
    font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.4px; text-transform: uppercase;
    padding: 0.3rem 0.7rem; border-radius: 999px;
    margin-bottom: 1rem;
  }
  .ba-tag-before { background: var(--sand-2); color: var(--ink-soft); }
  .ba-tag-after { background: var(--teal); color: #fff; }
  .ba-notes {
    list-style: none; margin: 1.1rem auto 0; padding: 0;
    display: inline-grid; gap: 0.5rem; text-align: left;
  }
  .ba-notes li {
    position: relative; padding-left: 1.6rem;
    color: var(--ink-soft); font-size: 0.95rem;
  }
  .ba-notes li::before {
    content: "✓"; position: absolute; left: 0;
    color: var(--teal); font-weight: 700;
  }

  .cards-3 { display: grid; gap: 1.25rem; margin-top: 1.5rem; }
  .card {
    background: var(--surface); border: 1px solid var(--sand-line);
    border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow);
  }
  .card h3 { margin-bottom: 0.5rem; }
  .card p { margin: 0; font-size: 0.95rem; }

  .includes { list-style: none; margin: 1.5rem 0 0; display: grid; gap: 0.75rem; }
  .includes li { padding-left: 1.75rem; position: relative; color: var(--ink-soft); }
  .includes li::before { content: "✓"; position: absolute; left: 0; color: var(--teal); font-weight: 700; }

  .steps { list-style: none; margin: 1.5rem 0 0; display: grid; gap: 1.25rem; }
  .steps li { display: flex; gap: 1rem; align-items: flex-start; }
  .steps p { margin: 0.2rem 0 0; font-size: 0.95rem; }
  .step-num {
    flex: 0 0 auto; width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    background: var(--teal); color: #fff; border-radius: 50%;
    font-weight: 700; font-family: var(--font-display);
  }

  .prix-cta { text-align: center; }
  .price-amount { font-family: var(--font-display); font-size: 3.2rem; font-weight: 700; color: var(--teal); }
  .prix-cta .price-note { margin-bottom: 0.75rem; }
  .price-anchor {
    max-width: 46ch; margin: 0 auto 1.5rem;
    color: var(--ink-soft); font-size: 0.95rem; line-height: 1.5;
  }
  .guarantee {
    margin: 1rem 0 0; color: var(--ink-soft);
    font-size: 0.95rem; font-weight: 600;
  }
  .legal-micro {
    max-width: 60ch; margin: 2.5rem auto 0;
    padding: 0 1.25rem; text-align: center;
    color: var(--ink-muted); font-size: 0.8rem; line-height: 1.5;
  }

  .reviewer {
    max-width: 30rem; margin: 0 auto 1.75rem;
    padding: 1.5rem; border: 1px solid var(--sand-line);
    border-radius: var(--radius); background: var(--surface);
    box-shadow: var(--shadow);
  }
  .reviewer-portrait {
    width: 96px; height: 96px; border-radius: 50%;
    object-fit: cover; border: 3px solid var(--teal-soft);
  }
  .reviewer-title {
    font-family: var(--font-display); font-weight: 700;
    font-size: 1.15rem; color: var(--teal);
    margin: 0.75rem 0 0.75rem;
  }
  .reviewer-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 0.6rem; text-align: left;
  }
  .reviewer-list li {
    position: relative; padding-left: 1.6rem;
    color: var(--ink-soft); font-size: 0.95rem; line-height: 1.4;
  }
  .reviewer-list li::before {
    content: "✓"; position: absolute; left: 0;
    color: var(--teal); font-weight: 700;
  }

  .faq { display: grid; gap: 1.25rem; margin-top: 1.5rem; }
  .faq-item h3 { margin-bottom: 0.3rem; font-size: 1.05rem; }
  .faq-item p { margin: 0; }

  .app-cta { text-align: center; }
  .app-cta p { margin: 0.5rem 0 1.25rem; }
  .app-cta .store-buttons { justify-content: center; }

  @media (min-width: 720px) {
    .cards-3 { grid-template-columns: repeat(3, 1fr); }
    .includes { grid-template-columns: 1fr 1fr; }
    .faq { grid-template-columns: 1fr 1fr; }
    .ba-grid { grid-template-columns: 1fr 1fr; align-items: start; }
  }
</style>
