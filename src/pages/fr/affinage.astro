---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FORMSPREE_AFFINAGE, STRIPE_PAYMENT_LINK } from '../../config';
---
<BaseLayout
  title="Affinage"
  description="Un itinéraire sur-mesure, affiné à la main. 69 € — livré sous quelques jours."
>
  <!-- OFFRE -->
  <section class="section affinage-hero">
    <div class="container">
      <span class="badge">Affinage</span>
      <h1>Ton itinéraire, ciselé à la main.</h1>
      <p class="lead">
        PackLight génère une base en 30 secondes. L'Affinage va plus loin : on
        reprend ton projet et on te livre un itinéraire sur-mesure, pensé par un
        humain qui connaît ta destination.
      </p>
      <div class="price">
        <span class="price-amount">69&nbsp;€</span>
        <span class="price-note">paiement unique · livré sous quelques jours</span>
      </div>
    </div>
  </section>

  <!-- CE QUE TU REÇOIS -->
  <section class="section">
    <div class="container">
      <ul class="includes">
        <li>Un itinéraire jour par jour, optimisé selon ton rythme et ton budget.</li>
        <li>Des adresses confidentielles, loin des pièges à touristes.</li>
        <li>Des alternatives selon la météo, ton profil et tes envies.</li>
        <li>Un échange pour ajuster avant la version finale.</li>
      </ul>
    </div>
  </section>

  <!-- FORMULAIRE -->
  <section class="section">
    <div class="container prose">
      <h2>Lance ton Affinage</h2>
      <p>Décris ton projet. On revient vers toi, puis tu règles les 69&nbsp;€ pour lancer le travail.</p>

      <form class="affinage-form" action={FORMSPREE_AFFINAGE} method="POST">
        <input type="hidden" name="_subject" value="Nouvelle demande d'Affinage — PackLight" />
        <input type="hidden" name="source" value="site — formulaire affinage" />

        <div class="field">
          <label for="af-dest">Destination</label>
          <input id="af-dest" name="destination" type="text" required placeholder="Ex. Japon, Pérou, road-trip Écosse…" />
        </div>

        <div class="field-row">
          <div class="field">
            <label for="af-start">Date de départ</label>
            <input id="af-start" name="date_depart" type="date" />
          </div>
          <div class="field">
            <label for="af-end">Date de retour</label>
            <input id="af-end" name="date_retour" type="date" />
          </div>
        </div>

        <div class="field">
          <label for="af-profil">Profil de voyage</label>
          <select id="af-profil" name="profil">
            <option value="">Choisis…</option>
            <option>Solo</option>
            <option>En couple</option>
            <option>En famille</option>
            <option>Entre amis</option>
          </select>
        </div>

        <div class="field">
          <label for="af-notes">Ton projet en quelques mots</label>
          <textarea id="af-notes" name="projet" rows="4" placeholder="Budget, style, envies, contraintes…"></textarea>
        </div>

        <div class="field">
          <label for="af-email">Ton email</label>
          <input id="af-email" name="email" type="email" required placeholder="ton@email.com" autocomplete="email" />
        </div>

        <button type="submit" class="btn btn-primary">Envoyer ma demande</button>
      </form>

      <div class="affinage-next" hidden>
        <p class="affinage-ok">Demande reçue ! Dernière étape : règle ton Affinage pour lancer le travail.</p>
        <a class="btn btn-amber" href={STRIPE_PAYMENT_LINK} data-stripe>Payer 69&nbsp;€</a>
      </div>
      <p class="affinage-error" hidden>Oups, une erreur est survenue. Réessaie dans un instant.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .affinage-hero { padding-bottom: 1rem; }
  .badge {
    display: inline-block;
    background: var(--amber); color: #fff;
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.5px;
    text-transform: uppercase; padding: 0.3rem 0.7rem;
    border-radius: 999px; margin-bottom: 1rem;
  }
  .lead { font-size: 1.15rem; max-width: 52ch; margin: 1rem 0 1.5rem; }
  .price { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
  .price-amount { font-family: var(--font-display); font-size: 2.6rem; font-weight: 700; color: var(--teal); }
  .price-note { color: var(--ink-muted); font-size: 0.95rem; }

  .includes { list-style: none; margin: 0; display: grid; gap: 0.75rem; }
  .includes li { padding-left: 1.75rem; position: relative; color: var(--ink-soft); }
  .includes li::before {
    content: "✓"; position: absolute; left: 0; top: 0;
    color: var(--teal); font-weight: 700;
  }

  .affinage-form { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .field { display: grid; gap: 0.4rem; }
  .field-row { display: grid; gap: 1rem; }
  .affinage-ok { color: var(--teal); font-weight: 600; }
  .affinage-next { margin-top: 1.5rem; }
  .affinage-error { color: var(--amber-dark); font-weight: 600; margin-top: 1rem; }

  @media (min-width: 560px) {
    .field-row { grid-template-columns: 1fr 1fr; }
    .includes { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.affinage-form');
  const next = document.querySelector<HTMLElement>('.affinage-next');
  const errorMsg = document.querySelector<HTMLElement>('.affinage-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg?.setAttribute('hidden', '');
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.setAttribute('hidden', '');
        next?.removeAttribute('hidden');
        next?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        errorMsg?.removeAttribute('hidden');
      }
    } catch {
      errorMsg?.removeAttribute('hidden');
    }
  });
</script>
