---
// Page racine : détection de langue côté client.
// 1) choix explicite mémorisé (clic sur le switch) → localStorage / cookie pl-lang
// 2) sinon langue du navigateur : en-* → /en, sinon /fr
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, follow" />
  <title>PackLight</title>
  <link rel="canonical" href="https://getpacklight.com/fr" />
  <script is:inline>
    (function () {
      var lang = null;
      // 1) Choix explicite déjà exprimé par l'utilisateur.
      try { lang = localStorage.getItem('pl-lang'); } catch (e) {}
      if (lang !== 'en' && lang !== 'fr') {
        var m = document.cookie.match(/(?:^|; )pl-lang=([^;]+)/);
        if (m) lang = decodeURIComponent(m[1]);
      }
      // 2) Sinon, langue du navigateur (repli FR).
      if (lang !== 'en' && lang !== 'fr') {
        var nav = (navigator.language || navigator.userLanguage || 'fr').toLowerCase();
        lang = nav.indexOf('en') === 0 ? 'en' : 'fr';
      }
      window.location.replace('/' + lang);
    })();
  </script>
  <meta http-equiv="refresh" content="0; url=/fr" />
</head>
<body>
  <p>Redirecting… <a href="/fr">Français</a> · <a href="/en">English</a></p>
</body>
</html>
