---
// Page racine : détecte la langue du navigateur et redirige. Repli FR.
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, follow" />
  <title>PackLight</title>
  <link rel="canonical" href="https://getpacklight.com/fr/" />
  <script is:inline>
    (function () {
      var l = (navigator.language || navigator.userLanguage || 'fr').toLowerCase();
      window.location.replace(l.indexOf('en') === 0 ? '/en/' : '/fr/');
    })();
  </script>
  <meta http-equiv="refresh" content="0; url=/fr/" />
</head>
<body>
  <p>Redirection… <a href="/fr/">PackLight</a></p>
</body>
</html>
