---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyDownload from '../components/StickyDownload.astro';
import { SITE_NAME } from '../config';
import { getLangFromUrl, useTranslations, alternatesFor } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /** Chemin de l'image OG (placeholder par défaut, à remplacer). */
  ogImage?: string;
  /** noindex pour pages techniques. */
  noindex?: boolean;
  /** Chemins FR/EN équivalents (hreflang + switch). null = pas d'équivalent. */
  alternates?: { fr: string; en: string } | null;
  /** Affiche la barre « Télécharger » sticky mobile (désactivée si la page a son propre CTA sticky). */
  stickyDownload?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title,
  description = t('footer.tagline'),
  ogImage = '/assets/og-default.jpg',
  noindex = false,
  alternates = alternatesFor(Astro.url),
  stickyDownload = true,
} = Astro.props;

const tagline = t('footer.tagline');
const pageTitle = title ? `${title} — ${SITE_NAME}` : `${SITE_NAME} — ${tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const ogLocale = lang === 'en' ? 'en_US' : 'fr_FR';
const abs = (p: string) => new URL(p, Astro.site).href;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}

  {alternates && (
    <>
      <link rel="alternate" hreflang="fr" href={abs(alternates.fr)} />
      <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
      <link rel="alternate" hreflang="x-default" href={abs(alternates.fr)} />
    </>
  )}

  <!-- Open Graph / Twitter -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:locale" content={ogLocale} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/logo-32.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/logo-512.png" />
  <link rel="apple-touch-icon" href="/assets/logo-192.png" />

  <!-- Polices : Playfair Display (titres) + Montserrat (corps) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
  />

  <!-- Travelpayouts (Drive verification) -->
  <script is:inline nowprocket data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">
    (function () {
      var script = document.createElement("script");
      script.async = 1;
      script.setAttribute("data-cmp-ab", "2");
      script.src = 'https://tp-em.com/NTcyNTk4.js?t=572598';
      document.head.appendChild(script);
    })();
  </script>
</head>
<body>
  <Header alternates={alternates} />
  <main>
    <slot />
  </main>
  <Footer alternates={alternates} />
  {stickyDownload && <StickyDownload />}

  <!-- Apparition au scroll : opacity + translateY, stagger 80 ms. -->
  <script is:inline>
    (function () {
      var els = document.querySelectorAll('.reveal');
      if (!els.length) return;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach(function (e) { e.classList.add('in'); });
        return;
      }
      var groups = new Map();
      els.forEach(function (e) {
        var p = e.parentElement;
        if (!groups.has(p)) groups.set(p, 0);
        e.setAttribute('data-sidx', groups.get(p));
        groups.set(p, groups.get(p) + 1);
      });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting) return;
          var i = parseInt(en.target.getAttribute('data-sidx') || '0', 10);
          en.target.style.transitionDelay = (i * 80) + 'ms';
          en.target.classList.add('in');
          io.unobserve(en.target);
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
      els.forEach(function (e) { io.observe(e); });
    })();
  </script>
</body>
</html>
