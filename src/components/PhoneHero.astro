---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const alt = lang === 'en'
  ? 'PackLight app generating a travel itinerary'
  : "L'application PackLight génère un itinéraire de voyage";
---
<div class="phone" role="img" aria-label={alt}>
  <div class="phone-screen">
    <video
      class="phone-video"
      muted
      loop
      playsinline
      preload="metadata"
      poster="/assets/video/hero-demo-poster.jpg"
    >
      <source src="/assets/video/hero-demo.webm" type="video/webm" />
      <source src="/assets/video/hero-demo.mp4" type="video/mp4" />
    </video>
  </div>
</div>

<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var v = document.currentScript.parentElement.querySelector('.phone-video');
    if (!v) return;
    // Reduced motion: keep the poster only (video stays paused).
    if (reduce) return;
    v.setAttribute('autoplay', '');
    var play = function () { var p = v.play(); if (p && p.catch) p.catch(function () {}); };
    if (v.readyState >= 2) play();
    else v.addEventListener('loadeddata', play, { once: true });
  })();
</script>

<style>
  .phone {
    position: relative;
    width: 60%;
    max-width: 260px;
    margin: 0 auto;
    aspect-ratio: 540 / 1214;
    border-radius: 34px;
    padding: 10px;
    background: linear-gradient(160deg, #20302d, #0b1b18);
    box-shadow:
      0 2px 2px rgba(255, 255, 255, 0.18) inset,
      0 22px 50px rgba(8, 28, 26, 0.45);
  }
  /* Encoche */
  .phone::before {
    content: "";
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 34%;
    height: 16px;
    background: #0b1b18;
    border-radius: 0 0 12px 12px;
    z-index: 2;
  }
  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 25px;
    overflow: hidden;
    background: var(--sand-2);
  }
  .phone-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .phone { animation: phone-float 6s ease-in-out infinite; }
  }
  @keyframes phone-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  @media (min-width: 820px) {
    .phone { width: 100%; max-width: 300px; }
  }
</style>
