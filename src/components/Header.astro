---
import { STORE_SMART_LINK } from '../config';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const download = `${STORE_SMART_LINK}&utm_medium=nav`;
---
<header class="site-header">
  <div class="container bar">
    <a href={localizedPath(lang)} class="brand">
      <img src="/assets/logo-64.png" alt="PackLight" width="30" height="30" />
      <span>PackLight</span>
    </a>
    <nav class="nav">
      <a href={localizedPath(lang, 'destinations')}>{t('nav.destinations')}</a>
      <a href={localizedPath(lang, 'affinage')}>{t('nav.affinage')}</a>
      <a href={localizedPath(lang, 'a-propos')}>{t('nav.about')}</a>
      <a href={localizedPath(lang, 'partenaires')}>{t('nav.partners')}</a>
      <a href={download} class="btn btn-primary nav-cta">{t('nav.download')}</a>
    </nav>
  </div>
</header>
