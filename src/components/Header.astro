---
import { STORE_SMART_LINK } from '../config';
import { getLangFromUrl, useTranslations, route } from '../i18n/utils';

interface Props {
  /** Chemins FR/EN équivalents de la page courante (switch de langue). */
  alternates?: { fr: string; en: string } | null;
}
const { alternates = null } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const download = `${STORE_SMART_LINK}&utm_campaign=${lang === 'en' ? 'header_en' : 'header'}`;

const other = lang === 'fr' ? 'en' : 'fr';
const switchHref = alternates ? alternates[other] : route(other, 'home');

const aria = {
  main: lang === 'en' ? 'Main navigation' : 'Navigation principale',
  mobile: lang === 'en' ? 'Mobile navigation' : 'Navigation mobile',
  open: lang === 'en' ? 'Open menu' : 'Ouvrir le menu',
  close: lang === 'en' ? 'Close menu' : 'Fermer le menu',
};

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
  { href: route(lang, 'destinations'), label: t('nav.destinations') },
  { href: route(lang, 'tailored'), label: t('nav.affinage') },
  { href: route(lang, 'about'), label: t('nav.about') },
  { href: route(lang, 'partners'), label: t('nav.partners') },
];
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return path === h || path.startsWith(h + '/');
};
---
<header class="site-header">
  <div class="container bar">
    <a href={route(lang, 'home')} class="brand">
      <img src="/assets/logo-64.png" alt="PackLight" width="30" height="30" />
      <span>PackLight</span>
    </a>

    <nav class="nav" aria-label={aria.main}>
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['nav-link', { active: isActive(l.href) }]}
          aria-current={isActive(l.href) ? 'page' : undefined}
        >{l.label}</a>
      ))}
      <a href={download} class="btn btn-primary nav-cta">{t('nav.download')}</a>
      <span class="lang-switch" aria-label="Language">
        <span class="lang-current" aria-current="true">{lang.toUpperCase()}</span>
        <a class="lang-alt" href={switchHref} data-set-lang={other}>{other.toUpperCase()}</a>
      </span>
    </nav>

    <button
      type="button"
      class="nav-toggle"
      aria-label={aria.open}
      data-label-open={aria.open}
      data-label-close={aria.close}
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav" hidden>
  <nav aria-label={aria.mobile}>
    {links.map((l) => (
      <a
        href={l.href}
        class:list={['mobile-link', { active: isActive(l.href) }]}
        aria-current={isActive(l.href) ? 'page' : undefined}
      >{l.label}</a>
    ))}
    <a href={download} class="btn btn-primary mobile-cta">{t('nav.download')}</a>
    <span class="lang-switch mobile-lang" aria-label="Language">
      <span class="lang-current" aria-current="true">{lang.toUpperCase()}</span>
      <a class="lang-alt" href={switchHref} data-set-lang={other}>{other.toUpperCase()}</a>
    </span>
  </nav>
</div>

<script is:inline>
  (function () {
    var toggle = document.querySelector('.nav-toggle');
    var panel = document.getElementById('mobile-nav');

    // Store an explicit language choice (switch click) so the root page
    // respects it on the next visit.
    function persist(l) {
      try { localStorage.setItem('pl-lang', l); } catch (e) {}
      document.cookie = 'pl-lang=' + l + ';path=/;max-age=31536000;samesite=lax';
    }
    document.querySelectorAll('.lang-alt').forEach(function (a) {
      a.addEventListener('click', function () {
        var l = a.getAttribute('data-set-lang');
        if (l) persist(l);
      });
    });

    // Header : fond qui se densifie au scroll.
    var header = document.querySelector('.site-header');
    if (header) {
      var onScroll = function () {
        header.classList.toggle('scrolled', window.scrollY > 20);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    if (!toggle || !panel) return;

    function setOpen(open) {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open
        ? toggle.getAttribute('data-label-close')
        : toggle.getAttribute('data-label-open'));
      toggle.classList.toggle('is-open', open);
      document.body.classList.toggle('nav-locked', open);
      if (open) {
        panel.hidden = false;
        requestAnimationFrame(function () { panel.classList.add('open'); });
      } else {
        panel.classList.remove('open');
        setTimeout(function () { panel.hidden = true; }, 200);
      }
    }

    toggle.addEventListener('click', function () {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    panel.addEventListener('click', function (e) {
      if (e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
  })();
</script>
