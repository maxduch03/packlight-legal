---
import { CONTACT_EMAIL, STORE_SMART_LINK } from '../config';
import { getLangFromUrl, useTranslations, route } from '../i18n/utils';

interface Props {
  alternates?: { fr: string; en: string } | null;
}
const { alternates = null } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const other = lang === 'fr' ? 'en' : 'fr';
const switchHref = alternates ? alternates[other] : route(other, 'home');
const store = `${STORE_SMART_LINK}&utm_campaign=${lang === 'en' ? 'footer_en' : 'footer'}&utm_medium=footer`;

const madeIn = lang === 'en'
  ? 'Made in Surfers Paradise by a French traveller.'
  : 'Fait à Surfers Paradise par un voyageur français.';
---
<footer class="site-footer">
  <div class="container cols">
    <div>
      <div class="brand">
        <img src="/assets/logo-64.png" alt="" width="30" height="30" />
        <span>PackLight</span>
      </div>
      <p style="color: rgba(255,255,255,0.72); max-width: 32ch;">{t('footer.tagline')}</p>
      <div class="footer-stores">
        <a class="footer-store" href={store} aria-label={t('store.appstore')}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.05 12.04c-.03-2.6 2.12-3.85 2.22-3.91-1.21-1.77-3.09-2.01-3.76-2.04-1.6-.16-3.12.94-3.93.94-.81 0-2.06-.92-3.39-.9-1.74.03-3.35 1.01-4.25 2.57-1.81 3.14-.46 7.79 1.3 10.34.86 1.25 1.89 2.65 3.23 2.6 1.3-.05 1.79-.84 3.36-.84 1.57 0 2.01.84 3.38.81 1.4-.02 2.28-1.27 3.13-2.53.99-1.45 1.4-2.86 1.42-2.93-.03-.01-2.72-1.04-2.75-4.12zM14.47 4.66c.71-.86 1.19-2.06 1.06-3.26-1.02.04-2.26.68-2.99 1.54-.66.76-1.23 1.98-1.08 3.15 1.14.09 2.3-.58 3.01-1.43z"/></svg>
          {t('store.appstore')}
        </a>
        <a class="footer-store" href={store} aria-label={t('store.googleplay')}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 2.4c-.3.3-.5.8-.5 1.4v16.4c0 .6.2 1.1.5 1.4l.1.1 9.2-9.2v-.2L3.6 2.4zm12.3 12.3l-3.1-3.1 3.1-3.1 3.7 2.1c1 .6 1 1.5 0 2.1l-3.7 2zm-1-4.1L5.9 1.8c.3-.1.7 0 1 .2l10.7 6.1-2.4 2.4zm0 2.8l2.4 2.4-10.7 6.1c-.4.2-.8.3-1.1.2l8.4-8.7z"/></svg>
          {t('store.googleplay')}
        </a>
      </div>
    </div>
    <div>
      <strong style="color:#fff; display:block; margin-bottom:0.6rem;">{t('footer.explore')}</strong>
      <nav style="flex-direction: column; gap: 0.55rem;">
        <a href={route(lang, 'destinations')}>{t('nav.destinations')}</a>
        <a href={route(lang, 'tailored')}>{t('nav.affinage')}</a>
        <a href={route(lang, 'about')}>{t('nav.about')}</a>
        <a href={route(lang, 'partners')}>{t('nav.partners')}</a>
      </nav>
    </div>
    <div>
      <strong style="color:#fff; display:block; margin-bottom:0.6rem;">{t('footer.legal')}</strong>
      <nav style="flex-direction: column; gap: 0.55rem;">
        <a href="/privacy">{t('footer.privacy')}</a>
        <a href="/terms">{t('footer.terms')}</a>
        <a href="/legal">{t('footer.legalNotice')}</a>
        <a href={`mailto:${CONTACT_EMAIL}`}>{t('footer.contact')}</a>
      </nav>
    </div>
  </div>
  <div class="container footer-bottom">
    <p class="legal-note">© {year} PackLight — Maxime Ducher. {t('footer.rights')} · {madeIn}</p>
    <span class="lang-switch footer-lang" aria-label="Language">
      <span class="lang-current" aria-current="true">{lang.toUpperCase()}</span>
      <a class="lang-alt" href={switchHref} data-set-lang={other}>{other.toUpperCase()}</a>
    </span>
  </div>
</footer>
