---
import { INSTAGRAM_REEL_URL } from '../config';
import { getLangFromUrl } from '../i18n/utils';

// Tant que l'URL n'est pas renseignée, on garde le poster non cliquable.
const hasReel = INSTAGRAM_REEL_URL !== 'INSTAGRAM_REEL_URL' && INSTAGRAM_REEL_URL.length > 0;
const lang = getLangFromUrl(Astro.url);
const poster = lang === 'en' ? '/assets/reel-poster-en.webp' : '/assets/reel-poster.webp';
const playLabel = lang === 'en'
  ? 'Play the PackLight intro video on Instagram'
  : 'Lire la vidéo de présentation PackLight sur Instagram';
const posterAlt = lang === 'en'
  ? 'Preview of the PackLight app in action'
  : "Aperçu de l'application PackLight en action";
---
<div class="reel" data-reel-url={hasReel ? INSTAGRAM_REEL_URL : undefined}>
  <button type="button" class="reel-poster" aria-label={playLabel}>
    <img src={poster} alt={posterAlt} width="1080" height="1935" loading="lazy" />
    <span class="reel-play" aria-hidden="true">▶</span>
  </button>
</div>

{hasReel && (
  <script is:inline>
    (function () {
      var reel = document.currentScript.previousElementSibling;
      if (!reel || !reel.classList.contains('reel')) return;
      var btn = reel.querySelector('.reel-poster');
      var url = reel.getAttribute('data-reel-url');
      if (!btn || !url) return;

      btn.addEventListener('click', function () {
        // Replace the poster with the official Instagram embed.
        var block = document.createElement('blockquote');
        block.className = 'instagram-media';
        block.setAttribute('data-instgrm-permalink', url);
        block.setAttribute('data-instgrm-version', '14');
        block.style.cssText = 'margin:0; width:100%;';
        reel.innerHTML = '';
        reel.appendChild(block);

        var done = false;
        function fallback() {
          if (done) return;
          done = true;
          window.open(url, '_blank', 'noopener');
        }

        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.instagram.com/embed.js';
        script.onload = function () {
          done = true;
          if (window.instgrm && window.instgrm.Embeds) {
            window.instgrm.Embeds.process();
          }
        };
        script.onerror = fallback;
        document.body.appendChild(script);

        // If the embed is blocked (adblock, privacy, network), open in a tab.
        setTimeout(fallback, 4000);
      }, { once: true });
    })();
  </script>
)}

{lang === 'en' && (
  <p class="reel-note">Demo in French, subtitled — English version coming soon.</p>
)}

<style>
  .reel {
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
  }
  .reel-poster {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    border: none;
    padding: 0;
    cursor: pointer;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--sand-2);
    box-shadow: var(--shadow-lg);
  }
  .reel-poster img { width: 100%; height: 100%; object-fit: cover; }
  .reel-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 64px; height: 64px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(15, 118, 110, 0.92);
    color: #fff;
    border-radius: 50%;
    font-size: 1.4rem;
    padding-left: 4px;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .reel-poster:hover .reel-play { transform: scale(1.06); background: rgba(15, 118, 110, 1); }
  .reel-note {
    margin: 0.9rem auto 0;
    max-width: 360px;
    text-align: center;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }
</style>
